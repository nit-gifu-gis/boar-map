{
  "name": "boar-map",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "test:browser": "playwright test",
    "format": "prettier --write --ignore-path .gitignore \"./src/**/*.{ts, tsx}\" \"./src/components/**/*.{ts,tsx}\" \"./src/pages/**/*.{ts,tsx}\""
  },
  "engines": {
    "node": "24.x",
    "yarn": "1.22.x"
  },
  "dependencies": {
    "@sentry/nextjs": "11.9.0",
    "exif-js": "^2.3.0",
    "leaflet": "^1.7.1",
    "leaflet-easybutton": "^2.4.0",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.4.3",
    "nookies": "^2.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "shpjs": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "^1.7.9",
    "@types/leaflet.markercluster": "^1.4.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/shpjs": "^3.4.1",
    "autoprefixer": "^10.4.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.4.5",
    "prettier": "^2.5.1",
    "prettier-plugin-tailwindcss": "^0.1.1",
    "tailwindcss": "3.0.24",
    "typescript": "5.9.3"
  },
  "volta": {
    "node": "24.22.1",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1"
}
